options:
  parameters:
    author: voyager_3
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "Hello BPSK \uC218\uC2E0 (Node B)"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: hello_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Hello BPSK \uC218\uC2E0 (Node B)"
    window_size: (1400,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: bpsk
  id: variable_constellation
  parameters:
    comment: "BPSK \uC131\uC0C1\uB3C4 \u2014 \uC1A1\uC218\uC2E0\uC774 \uAC19\uC740\
      \ \uAC83\uC744 \uC368\uC57C \uD55C\uB2E4"
    const_points: '[-1, 1]'
    dims: '1'
    normalization: digital.constellation.AMPLITUDE_NORMALIZATION
    npwr: '1.0'
    precision: '8'
    rot_sym: '2'
    soft_dec_lut: None
    sym_map: '[0, 1]'
    type: bpsk
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [728, 100.0]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: "1e9 \uB85C \uBC14\uAFD4\uB3C4 \uB418\uC9C0\uB9CC \uC8FC\uD30C\uC218\
      \ \uC624\uCC28\uAC00 8\uBC30 \uCEE4\uC9C4\uB2E4"
    value: 157.2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [672, 12.0]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: "RRC \uB864\uC624\uD504"
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 12.0]
    rotation: 0
    state: enabled
- name: out_file
  id: variable
  parameters:
    comment: "\uC5EC\uAE30\uC5D0 \uC800\uC7A5\uB41C\uB2E4 -> find_pattern.py \uB85C\
      \ \uD655\uC778"
    value: os.path.expanduser('~/hello_rx.bin')
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [464, 108.0]
    rotation: 0
    state: enabled
- name: rx_dev
  id: variable
  parameters:
    comment: "\uC218\uC2E0 \uC7A5\uBE44"
    value: '''type=b200'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 108.0]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable
  parameters:
    comment: ''
    value: '40'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 108.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: "\uC0D8\uD50C\uB808\uC774\uD2B8"
    value: 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12.0]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: "\uC2EC\uBCFC\uB2F9 \uC0D8\uD50C -> \uC2EC\uBCFC\uB960 250 ksym/s"
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 12.0]
    rotation: 0
    state: enabled
