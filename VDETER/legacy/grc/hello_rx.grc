    rotation: 0
    state: enabled
- name: matched
  id: root_raised_cosine_filter
  parameters:
    affinity: ''
    alias: ''
    alpha: excess_bw
    comment: "\uC815\uD569\uD544\uD130 \u2014 \uC1A1\uC2E0\uACFC \uAC19\uC740 RRC"
    decim: '1'
    gain: '1.0'
    interp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    ntaps: 11*sps+1
    samp_rate: samp_rate
    sym_rate: samp_rate/sps
    type: fir_filter_ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 228.0]
    rotation: 0
    state: enabled
- name: readme
  id: note
  parameters:
    alias: ''
    comment: ''
    note: "BPSK Hello \uC218\uC2E0 (Node B)   -   \uACB0\uACFC\uB294 ~/hello_rx.bin\
      \ \uC5D0 \uC800\uC7A5\nRRC Filter    : \uC1A1\uC2E0\uACFC \uAC19\uC740 \uD544\
      \uD130\uB85C \uC7A1\uC74C \uC81C\uAC70 Symbol Sync   : \uC2EC\uBCFC \uD55C\uAC00\
      \uC6B4\uB370 \uC2DC\uC810\uC744 \uCC3E\uC544 \uD45C\uBCF8 \uCD94\uCD9C Costas\
      \ Loop   : \uB450 \uC7A5\uBE44\uC758 \uC8FC\uD30C\uC218/\uC704\uC0C1 \uCC28\uC774\
      \ \uBCF4\uC815 (BPSK \uB294 order 2) Const Decoder : \uC810 \uC704\uCE58\uB85C\
      \ 0/1 \uD310\uC815 Diff Decoder  : \uC1A1\uC2E0\uC758 \uCC28\uB3D9\uBD80\uD638\
      \uD654\uB97C \uB418\uB3CC\uB9BC Repack Bits   : \uBE44\uD2B8 8\uAC1C\uB97C 1\uBC14\
      \uC774\uD2B8\uB85C  (MSB first \uD544\uC218)\n\uD654\uBA74 \uBCF4\uB294 \uBC95\
      \ \uC218\uC2E0 \uC2A4\uD399\uD2B8\uB7FC : \uAC00\uC6B4\uB370 \uBD09\uC6B0\uB9AC\
      \uAC00 \uC788\uC5B4\uC57C \uD568. \uC5C6\uC73C\uBA74 tx_gain \uBD80\uD130 \uC131\
      \uC0C1\uB3C4        : \uC88C\uC6B0 \uB450 \uB369\uC5B4\uB9AC\uBA74 \uC7A0\uAE34\
      \ \uAC83. \uB465\uADFC \uC6D0\uC774\uBA74 \uC2E0\uD638\uAC00 \uC57D\uD568\n\uC774\
      \ \uAD6C\uC131\uC5D0\uB294 \uB3D9\uAE30\uC5B4\uAC00 \uC5C6\uC5B4 \uBC14\uC774\
      \uD2B8 \uACBD\uACC4\uAC00 \uB9E4\uBC88 \uB2EC\uB77C\uC9C4\uB2E4. \uADF8\uB798\
      \uC11C \uD30C\uC77C\uC744 tools/find_pattern.py \uB85C \uD655\uC778\uD55C\uB2E4\
      \ (8\uAC00\uC9C0 \uC815\uB82C\uC744 \uB2E4 \uC2DC\uB3C4) \uC790\uC138\uD55C\
      \ \uC124\uBA85: docs/hello_bpsk_check.md"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 620]
    rotation: 0
    state: enabled
