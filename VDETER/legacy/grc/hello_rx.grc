  id: digital_constellation_decoder_cb
  parameters:
    affinity: ''
    alias: ''
    comment: "\uC2EC\uBCFC -> \uBE44\uD2B8 (\uBC14\uC774\uD2B8\uB2F9 1\uBE44\uD2B8\
