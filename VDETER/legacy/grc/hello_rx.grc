    comment: "\uC1A1\uC2E0\uC758 \uCC28\uB3D9 \uBD80\uD638\uD654\uB97C \uB418\uB3CC\
      \uB9B0\uB2E4 (BPSK 180\uB3C4 \uBAA8\uD638\uC131 \uD574\uC18C)"
    maxoutbuf: '0'
    minoutbuf: '0'
    modulus: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1216, 340.0]
    rotation: 0
