options:
  parameters:
    author: 'voyager_3'
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    copyright: ''
    description: 'Hello BPSK 수신 (Node B)'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: hello_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'Hello BPSK 수신 (Node B)'
    window_size: (1400,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: import_os
  id: import
  parameters:
    comment: ''
    imports: "import os"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 140]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: '샘플레이트'
    value: 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: '심볼당 샘플 -> 심볼률 250 ksym/s'
    value: 4
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [330, 12]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: 'RRC 롤오프'
    value: 0.35
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [420, 12]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: '1e9 로 바꿔도 되지만 주파수 오차가 8배 커진다'
    value: 157.2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [540, 12]
    rotation: 0
    state: enabled
- name: bpsk
  id: variable_constellation
  parameters:
    comment: 'BPSK 성상도 — 송수신이 같은 것을 써야 한다'
    type: bpsk
    sym_map: [0, 1]
    const_points: [-1, 1]
    rot_sym: 2
    dims: 1
    precision: 8
    npwr: 1.0
    soft_dec_lut: None
    normalization: digital.constellation.AMPLITUDE_NORMALIZATION
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 12]
    rotation: 0
    state: enabled
- name: rx_dev
  id: variable
  parameters:
    comment: '수신 장비'
    value: "'serial=34D6357'"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 84]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable
  parameters:
    comment: ''
    value: 40
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [380, 84]
    rotation: 0
    state: enabled
- name: out_file
  id: variable
  parameters:
    comment: '여기에 저장된다 -> find_pattern.py 로 확인'
    value: os.path.expanduser('~/hello_rx.bin')
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 84]
    rotation: 0
    state: enabled
- name: readme
  id: note
  parameters:
    comment: ''
    note: "BPSK Hello 수신 (Node B)   -   결과는 ~/hello_rx.bin 에 저장

RRC Filter    : 송신과 같은 필터로 잡음 제거
Symbol Sync   : 심볼 한가운데 시점을 찾아 표본 추출
Costas Loop   : 두 장비의 주파수/위상 차이 보정 (BPSK 는 order 2)
Const Decoder : 점 위치로 0/1 판정
Diff Decoder  : 송신의 차동부호화를 되돌림
Repack Bits   : 비트 8개를 1바이트로  (MSB first 필수)

화면 보는 법
  수신 스펙트럼 : 가운데 봉우리가 있어야 함. 없으면 tx_gain 부터
  성상도        : 좌우 두 덩어리면 잠긴 것. 둥근 원이면 신호가 약함

이 구성에는 동기어가 없어 바이트 경계가 매번 달라진다.
그래서 파일을 tools/find_pattern.py 로 확인한다 (8가지 정렬을 다 시도)
자세한 설명: docs/hello_bpsk_check.md"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 620]
    rotation: 0
    state: enabled
- name: usrp_source
  id: uhd_usrp_source
  parameters:
    comment: 'AGC 끔 — 신호가 약할 때 잡음을 물고 올라가는 것을 막는다'
    type: fc32
    otw: ''
    stream_args: ''
    stream_chans: []
    dev_addr: rx_dev
    dev_args: ''
    sync: ''
    clock_rate: 0e0
    num_mboards: 1
    nchan: 1
    start_time: -1
    clock_source0: ''
    time_source0: ''
    sd_spec0: ''
    center_freq0: center_freq
    gain0: rx_gain
    gain_type0: default
    ant0: 'RX2'
    bw0: 0
    lo_export0: False
    lo_source0: internal
    rx_agc0: 'Disabled'
    samp_rate: samp_rate
    maxoutbuf: 0
    minoutbuf: 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 260]
    rotation: 0
    state: enabled
- name: rx_spectrum
  id: qtgui_freq_sink_x
  parameters:
    comment: '★ 디버깅 1순위 — 봉우리가 안 보이면 TX Gain 부터 올린다'
    type: complex
    name: "수신 스펙트럼 (신호가 오는지 먼저 여기서 확인)"
    fftsize: 2048
    wintype: window.WIN_BLACKMAN_hARRIS
    fc: 0
    bw: samp_rate
    nconnections: 1
    update_time: 0.10
    average: 0.2
    grid: 'True'
    autoscale: 'True'
    ymin: -140
    ymax: -20
    gui_hint: ''
    showports: 'False'
    freqhalf: 'True'
    legend: 'True'
    axislabels: 'True'
    ctrlpanel: 'False'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_level: 0.0
    tr_chan: 0
    tr_tag: ''
    label1: ''
    width1: 1
    color1: "blue"
    alpha1: 1.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 400]
    rotation: 0
    state: enabled
- name: matched
  id: root_raised_cosine_filter
  parameters:
    comment: '정합필터 — 송신과 같은 RRC'
    type: fir_filter_ccf
    interp: 1
    decim: 1
    gain: 1.0
    samp_rate: samp_rate
    sym_rate: samp_rate/sps
    alpha: excess_bw
    ntaps: 11*sps+1
    maxoutbuf: 0
    minoutbuf: 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 260]
    rotation: 0
    state: enabled
- name: sym_sync
  id: digital_symbol_sync_xx
  parameters:
    comment: '심볼 시점 맞추기'
    type: cc
    ted_type: digital.TED_MUELLER_AND_MULLER
    constellation: bpsk
    sps: sps
    ted_gain: 1.0
    loop_bw: 0.045
    damping: 1.0
    max_dev: 1.5
    osps: 1
    resamp_type: digital.IR_MMSE_8TAP
    nfilters: 128
    pfb_mf_taps: []
    maxoutbuf: 0
    minoutbuf: 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [500, 260]
    rotation: 0
    state: enabled
- name: costas
  id: digital_costas_loop_cc
  parameters:
    comment: '반송파 위상/주파수 오차 보정 (BPSK 는 order 2)'
    w: 0.0628
    order: 2
    use_snr: False
    maxoutbuf: 0
    minoutbuf: 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 260]
    rotation: 0
    state: enabled
- name: const_view
  id: qtgui_const_sink_x
  parameters:
    comment: '잠기면 좌우 두 덩어리로 모인다'
    type: complex
    name: "성상도 (BPSK = 점 2개면 잠긴 것)"
    size: 1024
    grid: 'True'
    autoscale: 'True'
    ymin: -2
    ymax: 2
    xmin: -2
    xmax: 2
    nconnections: 1
    update_time: 0.10
    gui_hint: ''
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_level: 0.0
    tr_chan: 0
    tr_tag: ''
    legend: 'True'
    axislabels: 'True'
    label1: ''
    width1: 1
    color1: "blue"
    style1: 0
    marker1: 0
    alpha1: 1.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 400]
    rotation: 0
    state: enabled
- name: decoder
  id: digital_constellation_decoder_cb
  parameters:
    comment: '심볼 -> 비트 (바이트당 1비트)'
    constellation: bpsk
    maxoutbuf: 0
    minoutbuf: 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [940, 260]
    rotation: 0
    state: enabled
- name: diff_dec
  id: digital_diff_decoder_bb
  parameters:
    comment: '송신의 차동 부호화를 되돌린다 (BPSK 180도 모호성 해소)'
    coding: digital.DIFF_DIFFERENTIAL
    modulus: 2
    maxoutbuf: 0
    minoutbuf: 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [940, 340]
    rotation: 0
    state: enabled
- name: repack
  id: blocks_repack_bits_bb
  parameters:
    comment: '★ MSB first 필수 — 기본값 LSB first 로 두면 바이트 안 비트가 뒤집힌다'
    k: 1
    l: 8
    len_tag_key: ''
    align_output: 'False'
    endianness: gr.GR_MSB_FIRST
    maxoutbuf: 0
    minoutbuf: 0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [940, 420]
    rotation: 0
    state: enabled
- name: file_sink
  id: blocks_file_sink
  parameters:
    comment: 'find_pattern.py 로 확인할 파일'
    type: byte
    file: out_file
    vlen: 1
    unbuffered: 'True'
    append: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [940, 500]
    rotation: 0
    state: enabled

connections:
- [usrp_source, '0', rx_spectrum, '0']
- [usrp_source, '0', matched, '0']
- [matched, '0', sym_sync, '0']
- [sym_sync, '0', costas, '0']
- [costas, '0', const_view, '0']
- [costas, '0', decoder, '0']
- [decoder, '0', diff_dec, '0']
- [diff_dec, '0', repack, '0']
- [repack, '0', file_sink, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
