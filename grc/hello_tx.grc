options:
  parameters:
    author: voyager_3
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "Hello BPSK \uC1A1\uC2E0 (Node A)"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: hello_tx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Hello BPSK \uC1A1\uC2E0 (Node A)"
    window_size: (1400,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: bpsk
  id: variable_constellation
  parameters:
    comment: "BPSK \uC131\uC0C1\uB3C4 \u2014 \uC1A1\uC218\uC2E0\uC774 \uAC19\uC740\
      \ \uAC83\uC744 \uC368\uC57C \uD55C\uB2E4"
    const_points: '[-1, 1]'
    dims: '1'
    normalization: digital.constellation.AMPLITUDE_NORMALIZATION
    npwr: '1.0'
    precision: '8'
    rot_sym: '2'
    soft_dec_lut: None
    sym_map: '[0, 1]'
    type: bpsk
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 12]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: "1e9 \uB85C \uBC14\uAFD4\uB3C4 \uB418\uC9C0\uB9CC \uC8FC\uD30C\uC218\
      \ \uC624\uCC28\uAC00 8\uBC30 \uCEE4\uC9C4\uB2E4"
    value: 157.2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [540, 12]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: "RRC \uB864\uC624\uD504"
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [420, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: "\uC0D8\uD50C\uB808\uC774\uD2B8"
    value: 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: "\uC2EC\uBCFC\uB2F9 \uC0D8\uD50C -> \uC2EC\uBCFC\uB960 250 ksym/s"
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [330, 12]
    rotation: 0
    state: enabled
- name: tx_ampl
  id: variable
  parameters:
    comment: "DAC \uD480\uC2A4\uCF00\uC77C \uB300\uBE44"
    value: '0.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 84]
    rotation: 0
    state: enabled
- name: tx_dev
  id: variable
  parameters:
    comment: "\uC1A1\uC2E0 \uC7A5\uBE44"
    value: '''serial=34D6357'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 84]
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: "\u2605 \uC548 \uB418\uBA74 \uC5EC\uAE30\uBD80\uD130 \uC62C\uB9B0\uB2E4\
      \ (0 \uC740 \uCD5C\uC18C\uAC12)"
    value: '20'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [380, 84]
    rotation: 0
    state: enabled
- name: amp
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    const: tx_ampl
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 260]
    rotation: 0
    state: enabled
- name: hello_src
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: "'Hello' \uC758 \uC544\uC2A4\uD0A4 \uAC12. \uACC4\uC18D \uBC18\uBCF5\
      \ \uC1A1\uC2E0\uD55C\uB2E4"
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: byte
    vector: '[72, 101, 108, 108, 111]'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 260]
    rotation: 0
    state: enabled
- name: import_os
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import os
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 140]
    rotation: 0
    state: enabled
- name: modulator
  id: digital_constellation_modulator
  parameters:
    affinity: ''
    alias: ''
    comment: "\uBC14\uC774\uD2B8\uB97C MSB first \uB85C \uD480\uC5B4 BPSK \uB85C \uC2E3\
      \uACE0 RRC \uC131\uD615\uAE4C\uC9C0 \uD55C\uB2E4"
    constellation: bpsk
    differential: 'True'
    excess_bw: excess_bw
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_symbol: sps
    truncate: 'False'
    verbose: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [250, 260]
    rotation: 0
    state: enabled
- name: readme
  id: note
  parameters:
    alias: ''
    comment: ''
    note: "BPSK Hello \uC1A1\uC2E0 (Node A)   -   \uB9C1\uD06C \uC810\uAC80\uC6A9\
      , VDE-TER \uADDC\uACA9\uACFC \uBB34\uAD00\nVector Source  : Hello \uC758 \uC544\
      \uC2A4\uD0A4 \uCF54\uB4DC\uB97C \uBB34\uD55C \uBC18\uBCF5 Const Modulator: \uBC14\
      \uC774\uD2B8\uB97C \uBE44\uD2B8\uB85C \uD480\uACE0(MSB first) \uCC28\uB3D9\uBD80\
      \uD638\uD654 \uD6C4 BPSK+RRC Multiply Const : \uB514\uC9C0\uD138 \uB2E8 \uC9C4\
      \uD3ED \uC870\uC808 USRP Sink      : RF \uC1A1\uC2E0\n\uC548 \uB418\uBA74 tx_gain\
      \ \uC744 20 -> 30 -> 40 \uC73C\uB85C \uC62C\uB9B4 \uAC83 (0 \uC740 \uCD5C\uC18C\
      \uAC12) \u2605 \uC548\uD14C\uB098 \uC5C6\uC774 \uB3D9\uCD95 + 30dB \uAC10\uC1E0\
      \uAE30 \uACBD\uB85C\uC5D0\uC11C\uB9CC \uC2E4\uD589\n\uC218\uC2E0\uCE21: hello_rx.grc\
      \ / \uD655\uC778: tools/find_pattern.py ~/hello_rx.bin \uC790\uC138\uD55C \uC124\
      \uBA85: docs/hello_bpsk_check.md"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 560]
    rotation: 0
    state: enabled
