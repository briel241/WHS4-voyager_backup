__pycache__/
*.py[cod]
.venv/
venv/

# ============================================================
# macOS · 편집기
# ============================================================
.DS_Store
*.swp
.idea/
.vscode/

# Excel 임시 잠금 파일 (~$파일명.xlsx)
~$*.xlsx

# ============================================================
# 대용량 · 부수 자료 (저장소에 넣지 않음)
# ============================================================
# 참고 논문·표준 PDF — 저작권·용량 문제로 올리지 않는다
references/

# 원본 IQ 캡처 (재생성 가능, 대용량)
results/*.iq
# 생성되는 관찰 보고서 (앱 실행 시 재생성)
results/*.html
# 시나리오 실행 로그 (scenario_runner 실행 시 재생성)
results/*.json
# Stage 7 fixture (tools/make_stage7_fixtures.py로 재생성)
results/stage7-fixtures/
# RF 실측 원시 캡처 (.bin, 대용량). 그래프(.png)는 추적한다
results/captures/*.bin

# ============================================================
# 로컬 전용 — 업로드 대상 아님
# ============================================================
# 링크·PHY 계층은 GitHub VDETER/ 로 관리한다.
# 로컬 작업 사본(VDETER_Link/)은 커밋하지 않는다.
VDETER_Link/

# GNU Radio 실험용 플로우그래프 (RF 벤치 로컬 작업물, 재생성 가능)
grc/

# ============================================================
# Phase I standalone 영속 state (결정 15 — 배포·업데이트 불가침)
# ============================================================
# 자격 산물·run evidence·lock (var/)과 identity 저장소(개인키 포함)는
# git 밖의 기계 로컬 state다. 코드 업데이트가 삭제·덮어쓰지 않는다.
/var/
/identity/
/hardware.toml
